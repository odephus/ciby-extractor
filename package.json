{
  "name": "ciby",
  "version": "1.0.0",
  "description": "A cybernetic media extraction protocol.",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.odephus.ciby",
    "productName": "CIBY",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "CIBY Extractor",
      "createDesktopShortcut": true
    }
  },
  "keywords": [],
  "author": "Odephus",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "node-id3": "^0.2.9",
    "spotify-url-info": "^3.3.1",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
