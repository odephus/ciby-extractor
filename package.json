{
  "name": "ciby",
  "version": "1.0.3",
  "description": "A cybernetic media extraction protocol.",
  "main": "main.js",
  "scripts": {
    "test": "node --test",
    "test:electron": "node scripts/smoke-electron.cjs",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.odephus.ciby",
    "productName": "CIBY",
    "files": [
      "*.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/yt-dlp-exec/bin/**",
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "CIBY Extractor",
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "odephus",
        "repo": "ciby-extractor"
      }
    ]
  },
  "keywords": [],
  "author": "Odephus",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "spotify-url-info": "^3.3.1",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
